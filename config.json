{
  "description": "glusterFS plugin for Docker",
  "documentation": "https://github.com/antoniospatera/docker-volume-glusterfs",
  "entrypoint": ["/docker-volume-glusterfs"],
  "env": [
    {
      "name": "DEBUG",
      "settable": ["value"],
      "value": "0"
    },
    {
      "name": "SERVERS",
      "settable": ["value"],
      "value": ""
    },
    {
      "name": "VOLNAME",
      "settable": ["value"],
      "value": ""
    },
    {
      "name": "CLEANUP_INTERVAL",
      "settable": ["value"],
      "value": "0"
    }
  ],
  "interface": {
    "socket": "glusterfs.sock",
    "types": ["docker.volumedriver/1.0"]
  },
  "linux": {
    "capabilities": ["CAP_SYS_ADMIN"],
    "devices": [
      {
        "path": "/dev/fuse"
      }
    ]
  },
  "network": {
    "type": "host"
  },
  "propagatedMount": "/mnt/volumes"
}
